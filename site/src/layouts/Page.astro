---
import "../styles/archive.css";
import { sitePath } from "../data";
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Copilot Changelog Archive</title>
    <link rel="icon" href={sitePath("/favicon.svg")} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <a href={sitePath("/")} aria-label="Copilot Changelog Archive home">
        Copilot Changelog <span>Archive</span>
      </a>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>Mirrored announcements from GitHub Blog.</footer>
  </body>
</html>
