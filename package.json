{
  "name": "copilot-changelog-mirror",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/v2/*.test.ts",
    "test:browser": "node --import tsx --test tests/v2/native-site.browser.ts",
    "format:check": "prettier --check \"src/v2/**/*.ts\" \"tests/v2/**/*.ts\" \"tests/v2/**/*.mjs\" package.json tsconfig.json \"docs/v2-*.md\" \"site/**/*.{astro,ts,mjs,css,svg}\" .prettierrc.json \".github/workflows/*.yml\"",
    "site:build:directory": "node --import tsx src/v2/native-site-cli.ts",
    "capture:directory": "node --import tsx src/v2/capture-directory-cli.ts",
    "render:directory": "node --import tsx src/v2/render-directory-cli.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "astro": "7.3.6",
    "cheerio": "^1.1.2",
    "jsonc-parser": "3.3.1",
    "pagefind": "1.5.2",
    "rehype-raw": "7.0.0",
    "saxes": "6.0.0",
    "turndown": "^7.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.5",
    "markdown-it": "^14.3.1",
    "prettier": "3.6.2",
    "prettier-plugin-astro": "1.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "yaml": "2.9.1"
  }
}
