{
  "name": "copilot-changelog-mirror",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "capture": "node --import tsx src/v2/cli.ts capture",
    "render": "node --import tsx src/v2/cli.ts render",
    "cli": "node --import tsx src/v2/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/v2/*.test.ts",
    "format:check": "prettier --check \"src/v2/**/*.ts\" \"tests/v2/**/*.ts\" \"tests/v2/**/*.mjs\" package.json tsconfig.json docs/v2-archive.md"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "jsonc-parser": "3.3.1",
    "saxes": "6.0.0",
    "turndown": "^7.2.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.5",
    "markdown-it": "^14.3.1",
    "prettier": "3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
